# Copy to .env and adjust. Never commit .env.
APP_NAME=DFIP
# SQLite works out of the box for local dev; switch to the team's chosen DB, e.g.
# postgresql+psycopg://user:password@localhost:5432/dfip
DATABASE_URL=sqlite:///./dfip.db
JWT_SECRET_KEY=change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@dfip.local
ADMIN_PASSWORD=Admin@123
