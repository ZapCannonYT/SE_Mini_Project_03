# Copy to .env and adjust. Never commit .env.
APP_NAME=DFIP
# SQLite works out of the box for local dev; switch to the team's chosen DB, e.g.
# postgresql+psycopg://user:password@localhost:5432/dfip
DATABASE_URL=sqlite:///./dfip.db
# Set a long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
